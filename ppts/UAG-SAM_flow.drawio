        <mxCell id="e14" value="训练辅助" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;strokeWidth=1;strokeColor=#cc0000;dashed=1;fontSize=11;" edge="1" parent="1" source="training" target="update">
