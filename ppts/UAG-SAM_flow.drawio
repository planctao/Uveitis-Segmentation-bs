<mxfile host="app.diagrams.net" modified="2026-08-30T00:00:00.000Z" agent="Codex" version="24.7.17" compressed="false">
  <diagram id="uag-sam-flow" name="UAG-SAM Flow">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="UAG-SAM：面向 FA 渗漏的 Uncertainty-Aware Guided Interactive Refinement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f4e78;strokeColor=#163a5c;fontColor=#ffffff;fontStyle=1;fontSize=22;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1520" height="60" as="geometry" />
        </mxCell>

        <mxCell id="input" value="&lt;b&gt;FA 原图&lt;/b&gt;&lt;br/&gt;Fluorescein angiography" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="55" y="165" width="190" height="80" as="geometry" />
        </mxCell>

        <mxCell id="coarse" value="&lt;b&gt;DINOv3 ConvNeXt-Tiny&lt;br/&gt;+ VS-UBR&lt;/b&gt;&lt;br/&gt;语义粗分割器&lt;br/&gt;输出粗 logits z₀" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="300" y="145" width="260" height="120" as="geometry" />
        </mxCell>

        <mxCell id="state" value="&lt;b&gt;当前状态&lt;/b&gt;&lt;br/&gt;pₜ = sigmoid(zₜ)&lt;br/&gt;candidate mask = threshold(pₜ)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="625" y="145" width="245" height="120" as="geometry" />
        </mxCell>

        <mxCell id="uncertainty" value="&lt;b&gt;不确定性 + 局部边界&lt;/b&gt;&lt;br/&gt;u = 1 − 2|pₜ − 0.5|&lt;br/&gt;b = |pₜ − AvgPool(pₜ)|&lt;br/&gt;突出模糊边界/疑似错误区" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="930" y="100" width="285" height="135" as="geometry" />
        </mxCell>

        <mxCell id="policy" value="&lt;b&gt;无 GT 点击策略&lt;/b&gt;&lt;br/&gt;s⁺：不确定的低概率区 → 正点击&lt;br/&gt;s⁻：不确定的高概率区 → 负点击&lt;br/&gt;NMS + 最小间距；低优先级则停止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1260" y="95" width="290" height="145" as="geometry" />
        </mxCell>

        <mxCell id="doctor" value="&lt;b&gt;医生点击（可选）&lt;/b&gt;&lt;br/&gt;手动正/负点击覆盖系统建议&lt;br/&gt;模拟真实交互纠错" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1260" y="285" width="290" height="90" as="geometry" />
        </mxCell>

        <mxCell id="prompt" value="&lt;b&gt;17 通道 Soft Prompt&lt;/b&gt;&lt;br/&gt;image(3) + prob(2) + uncertainty(2)&lt;br/&gt;candidate(2) + positive/negative(4)&lt;br/&gt;signed(2) + reliability(2)&lt;br/&gt;&lt;i&gt;Gaussian heatmap，提示方向和可靠度&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="865" y="305" width="315" height="150" as="geometry" />
        </mxCell>

        <mxCell id="refiner" value="&lt;b&gt;UAG Residual Refiner&lt;/b&gt;&lt;br/&gt;轻量 U-Net&lt;br/&gt;uncertainty spatial gate&lt;br/&gt;prompt-conditioned FiLM&lt;br/&gt;预测 residual Δzₜ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1225" y="440" width="300" height="135" as="geometry" />
        </mxCell>

        <mxCell id="update" value="&lt;b&gt;受控残差更新&lt;/b&gt;&lt;br/&gt;zₜ₊₁ = zₜ + bounded(Δzₜ)&lt;br/&gt;residual step limit&lt;br/&gt;训练中可用 stop-gradient / teacher forcing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce5cd;strokeColor=#d79b00;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="870" y="510" width="315" height="135" as="geometry" />
        </mxCell>

        <mxCell id="stop" value="&lt;b&gt;交互停止判断&lt;/b&gt;&lt;br/&gt;max(s⁺, s⁻) &lt; min_priority&lt;br/&gt;→ 不再询问医生" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="520" y="710" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell id="final" value="&lt;b&gt;最终输出&lt;/b&gt;&lt;br/&gt;mask = threshold(sigmoid(zₜ))&lt;br/&gt;得到更完整、更准确的 lesion_1 / lesion_2 mask" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="850" y="715" width="350" height="100" as="geometry" />
        </mxCell>

        <mxCell id="training" value="&lt;b&gt;训练阶段辅助机制（部署时关闭）&lt;/b&gt;&lt;br/&gt;• GT residual 模拟 oracle clicks&lt;br/&gt;• click jitter / dropout&lt;br/&gt;• click-consistency loss&lt;br/&gt;• teacher forcing 稳定多轮 rollout&lt;br/&gt;&lt;br/&gt;&lt;b&gt;部署阶段：&lt;/b&gt;不读取 GT，只使用 uncertainty policy 或医生点击" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#cc0000;dashed=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="55" y="600" width="365" height="225" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="蓝/绿：主推理路径　 黄：uncertainty/policy　 紫：prompt/refiner　 橙：迭代稳定　 红虚线：训练辅助" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1230" y="735" width="325" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="image" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#4d6f8c;fontSize=12;" edge="1" parent="1" source="input" target="coarse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="z₀" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#4d6f8c;fontSize=12;" edge="1" parent="1" source="coarse" target="state">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="pₜ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#b38f00;fontSize=12;" edge="1" parent="1" source="state" target="uncertainty">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="uₜ, bₜ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#b38f00;fontSize=12;" edge="1" parent="1" source="uncertainty" target="policy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="建议正/负点击" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#b38f00;fontSize=12;" edge="1" parent="1" source="policy" target="prompt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="医生正/负点击" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#b85450;fontSize=12;" edge="1" parent="1" source="doctor" target="prompt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="17ch features" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#8064a2;fontSize=12;" edge="1" parent="1" source="prompt" target="refiner">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="Δzₜ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#8064a2;fontSize=12;" edge="1" parent="1" source="refiner" target="update">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="更新后的 zₜ₊₁" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#d79b00;fontSize=12;" edge="1" parent="1" source="update" target="final">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="循环反馈" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#d79b00;dashed=1;curved=1;fontSize=12;" edge="1" parent="1" source="update" target="state">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="780" y="580" />
              <mxPoint x="780" y="270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" value="低优先级" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#b38f00;dashed=1;fontSize=12;" edge="1" parent="1" source="policy" target="stop">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1400" y="650" />
              <mxPoint x="650" y="650" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e12" value="停止" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#82b366;fontSize=12;" edge="1" parent="1" source="stop" target="final">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="训练辅助" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;strokeWidth=1;strokeColor=#cc0000;dashed=1;fontSize=11;" edge="1" parent="1" source="training" target="prompt">
